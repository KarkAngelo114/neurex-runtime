{
  "name": "neurex-runtime",
  "version": "1.0.1",
  "description": "A port of Neurex where in you can run neurex models in your browser! 🚀",
  "main": "index.js",
  "module": "dist/neurex-runtime.esm.js",
  "browser": "dist/neurex-runtime.umd.js",
  "exports": {
      ".": {
          "import": "./index.mjs",
          "require": "./index.js"
      }
  },
  "files": [
      "dist/",
      "index.js",
      "index.mjs",
      "core/",
      "layers/",
      "params_init/",
      "utils/"
  ],
  "scripts": {
    "build":"rollup -c"

  },
  "keywords": [
    "neurex",
    "model",
    "nrx",
    "neural-network",
    "neural",
    "deep learning",
    "runtime"
  ],
  "author": "Kark Angelo V. Pada",
  "license": "MIT",
  "homepage": "https://github.com/KarkAngelo114/neurex-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarkAngelo114/neurex-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/KarkAngelo114/neurex-runtime/issues"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "rollup": "^2.80.0",
    "rollup-plugin-terser": "^7.0.2"
  }
}
